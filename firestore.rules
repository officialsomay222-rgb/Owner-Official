rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'officialsomay222@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPasskeyHash(hash) {
      return hash is string &&
        hash.size() == 64 &&
        hash == 'adaa118260b981ae2f48ffd08e5fc23da0aeddf7ff9c9979cdff54a0134feed6';
    }

    // Gate must NOT exist before this batch, and MUST exist after this batch with matching appId & passkeyHash
    function hasValidPasskeyGate(appId, gateId) {
      return isValidId(gateId) &&
        !exists(/databases/$(database)/documents/upload_gates/$(gateId)) &&
        existsAfter(/databases/$(database)/documents/upload_gates/$(gateId)) &&
        getAfter(/databases/$(database)/documents/upload_gates/$(gateId)).data.appId == appId &&
        isValidPasskeyHash(getAfter(/databases/$(database)/documents/upload_gates/$(gateId)).data.passkeyHash);
    }

    // Validation Blueprint: ApkApp
    function isValidApkApp(data) {
      return data.keys().hasAll([
          'name', 'desc', 'fullDesc', 'tag', 'version',
          'apkFileName', 'apkSize', 'apkUrl', 'image', 'url',
          'baseColor', 'chunkCount', 'features', 'tech',
          'ownerId', 'gateId', 'published', 'archived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'desc', 'fullDesc', 'tag', 'version',
          'apkFileName', 'apkSize', 'apkUrl', 'image', 'url',
          'baseColor', 'chunkCount', 'features', 'tech',
          'ownerId', 'gateId', 'published', 'archived', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.desc is string && data.desc.size() >= 1 && data.desc.size() <= 200 &&
        data.fullDesc is string && data.fullDesc.size() >= 1 && data.fullDesc.size() <= 1200 &&
        data.tag is string && data.tag.size() >= 1 && data.tag.size() <= 40 &&
        data.version is string && data.version.size() >= 1 && data.version.size() <= 30 &&
        data.apkFileName is string && data.apkFileName.size() >= 1 && data.apkFileName.size() <= 120 &&
        data.apkSize is string && data.apkSize.size() >= 1 && data.apkSize.size() <= 30 &&
        data.apkUrl is string && data.apkUrl.size() <= 1000 &&
        data.image is string && data.image.size() <= 350000 &&
        data.url is string && data.url.size() <= 500 &&
        data.baseColor is string && data.baseColor.size() >= 4 && data.baseColor.size() <= 30 && data.baseColor.matches('^#[0-9a-fA-F]{3,8}$') &&
        data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 40 &&
        data.features is list && data.features.size() >= 1 && data.features.size() <= 6 && data.features[0] is string && data.features[0].size() <= 120 &&
        data.tech is list && data.tech.size() >= 1 && data.tech.size() <= 6 && data.tech[0] is string && data.tech[0].size() <= 60 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.gateId) &&
        data.published is bool &&
        data.archived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: ApkChunk
    function isValidApkChunk(data) {
      return data.keys().hasAll(['appId', 'index', 'data', 'ownerId', 'gateId', 'createdAt']) &&
        data.keys().hasOnly(['appId', 'index', 'data', 'ownerId', 'gateId', 'createdAt']) &&
        data.appId is string && data.appId.size() >= 1 && data.appId.size() <= 128 && data.appId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.index is int && data.index >= 0 && data.index <= 40 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 750000 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.gateId) &&
        data.createdAt is timestamp;
    }

    // Write-only Atomic Upload Gate (zero read/list/update/delete)
    match /upload_gates/{gateId} {
      allow read, update, delete: if false;
      allow create: if isValidId(gateId) &&
        incoming().keys().hasAll(['passkeyHash', 'appId', 'createdAt']) &&
        incoming().keys().hasOnly(['passkeyHash', 'appId', 'createdAt']) &&
        isValidPasskeyHash(incoming().passkeyHash) &&
        isValidId(incoming().appId) &&
        incoming().createdAt == request.time;
    }

    // Admins registry (read-only from client)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // APK Showcase Apps Collection
    match /apk_apps/{appId} {
      allow get: if isValidId(appId) && ((resource != null && existing().published == true) || isAdmin());
      allow list: if existing().published == true || isAdmin();

      allow create: if isValidId(appId) &&
        isValidApkApp(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().ownerId == request.auth.uid) ||
          (hasValidPasskeyGate(appId, incoming().gateId) && incoming().ownerId == 'passkey_admin')
        );

      allow update: if isValidId(appId) &&
        isValidApkApp(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'desc', 'fullDesc', 'tag', 'version',
          'apkFileName', 'apkSize', 'apkUrl', 'image', 'url',
          'baseColor', 'chunkCount', 'features', 'tech',
          'published', 'archived', 'gateId', 'updatedAt'
        ]) &&
        (isAdmin() || hasValidPasskeyGate(appId, incoming().gateId));

      allow delete: if isSignedIn() && isValidId(appId) && isAdmin();

      // Binary APK Chunks Subcollection
      match /chunks/{chunkId} {
        allow get: if isValidId(appId) && isValidId(chunkId) && (
          get(/databases/$(database)/documents/apk_apps/$(appId)).data.published == true ||
          isAdmin()
        );
        allow list: if false;

        allow create: if isValidId(appId) &&
          isValidId(chunkId) &&
          isValidApkChunk(incoming()) &&
          incoming().appId == appId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/apk_apps/$(appId)) &&
          (
            (isAdmin() && incoming().ownerId == request.auth.uid && get(/databases/$(database)/documents/apk_apps/$(appId)).data.ownerId == request.auth.uid) ||
            (hasValidPasskeyGate(appId, incoming().gateId) && incoming().ownerId == 'passkey_admin')
          );

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(appId) && isValidId(chunkId) && isAdmin();
      }
    }
  }
}
